# Convex deployment configuration (place real values in .env.local, never commit secrets)
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
VITE_CONVEX_URL=
CONVEX_SITE_URL=

# Server-side Gemini API key (configured via Settings > Secrets or server environment; never prefix with VITE_)
GEMINI_API_KEY=

# OpenStreetMap / OSRM / CARTO basemap configuration
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
VITE_CARTO_API_KEY=

# Optional server-side Live Traffic provider (TomTom Traffic API — configure in Settings > Secrets or Render Environment; never prefix with VITE_)
TOMTOM_API_KEY=

# Backend JWT authentication secret (REQUIRED in production on Render; minimum 32 chars; NEVER prefix with VITE_ or commit real values)
JWT_SECRET=

# Production CORS & URL configuration (comma-separated allowed frontend origins for Render)
CORS_ORIGIN=
FRONTEND_URL=

# Optional frontend API base URL when frontend and backend are hosted on separate domains (leave empty for same-origin Express/Render deploy)
VITE_API_BASE_URL=

