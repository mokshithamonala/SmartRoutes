# Convex deployment configuration (place real values in .env.local, never commit secrets)
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
VITE_CONVEX_URL=
CONVEX_SITE_URL=

# Server-side Gemini API key (configured via Settings > Secrets or server environment; never prefix with VITE_)
GEMINI_API_KEY=

# OpenStreetMap / OSRM public service endpoints (configurable for self-hosted production instances)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
